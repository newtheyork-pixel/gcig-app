node_modules
.env
.env.local
.DS_Store
dist
server/uploads/*
!server/uploads/.gitkeep

# sea_tracker — local secrets and data must never be committed
sea_tracker/config.toml
sea_tracker/data/
sea_tracker/logs/
sea_tracker/.venv/
sea_tracker/*.egg-info/
sea_tracker/**/__pycache__/

# sandbox / grade_predictor — student essays must NEVER be committed
sandbox/data/
sandbox/.venv/
sandbox/.env
sandbox/*.egg-info/
sandbox/**/__pycache__/

# quant — vendor price data is licensed and enormous; the cache is
# rebuildable from a key and must never be committed.
quant/.venv/
quant/data/
quant/.env
quant/*.egg-info/
quant/**/__pycache__/
quant/.pytest_cache/

# Two things under quant/ are deliberately NOT ignored. Audit and
# backtest reports are the deliverable, so they belong in history where
# a result can be diffed against the run that produced it. And
# quant/trials.jsonl is the append-only count of every configuration
# ever tested — it feeds the Deflated Sharpe, so a version of this
# project where it can be quietly reset is a version where the headline
# number is unfalsifiable.
!quant/reports/
!quant/trials.jsonl
