<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleDisplayName</key><string>Griffin Fund</string>
  <!-- Both read from the build settings rather than being written here.
       Hardcoding them next to GENERATE_INFOPLIST_FILE = NO is why the
       commit titled 0.1.1 shipped an app that still called itself 0.1.0
       build 1: the MARKETING_VERSION bump had nothing to apply to, and
       the next upload would have been rejected as a duplicate build. -->
  <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
  <!-- Answers the export-compliance question at build time instead of
       in the console on every upload. It is false because the app
       implements no cryptography of its own: HTTPS goes through
       URLSession and the token sits in the Keychain, both of which are
       encryption within Apple's own operating system, which is exactly
       what the exemption covers. -->
  <key>ITSAppUsesNonExemptEncryption</key><false/>
  <!-- A launch screen is not decoration: without one the app flashes
       white for the second before SwiftUI paints, which on a dark
       terminal app reads as a bug. Same ground colour as T.bg, so the
       hand-off from launch image to first frame is invisible. -->
  <key>UILaunchScreen</key>
  <dict>
    <key>UIColorName</key><string>LaunchBG</string>
    <key>UIImageName</key><string>LaunchMark</string>
    <key>UIImageRespectsSafeAreaInsets</key><true/>
  </dict>
  <!-- All four, because TARGETED_DEVICE_FAMILY includes iPad and iPad
       multitasking requires every orientation to be declared. Upload
       rejects the bundle otherwise. The iPhone key below stays portrait
       only: this is a reader and an alerter, and a rotating one-column
       list buys nothing. -->
  <!-- Same scheme the Mac registers. NativeAuth.jsx hardcodes
       griffin-terminal://auth, so the phone must answer to it or the
       browser hand-back lands nowhere. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key><string>org.thegriffinfund.ios.auth</string>
      <key>CFBundleURLSchemes</key>
      <array><string>griffin-terminal</string></array>
    </dict>
  </array>
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>
  <key>UISupportedInterfaceOrientations~iphone</key>
  <array><string>UIInterfaceOrientationPortrait</string></array>
</dict>
</plist>
