<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The desk squawk box captures the microphone. Under the hardened
       runtime (which notarization requires) mic access is denied without
       this entitlement, no matter what the TCC prompt says. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
