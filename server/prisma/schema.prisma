generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  President
  CIO
  // Comms/PR officer. Not part of the investment hierarchy. Attendance
  // is NOT tracked for this role (see ATTENDANCE_EXEMPT_ROLES in
  // routes/attendance.js) — they don't attend regular club meetings
  // in a counted capacity.
  ChiefOfCommunication
  SeniorPortfolioManager
  PortfolioManager
  SeniorAnalyst
  Analyst
  JuniorAnalyst
  AdvisoryBoardMember
  FacultyAdvisory
  // Honorific only. Used solely as an extraRoles badge for a President who
  // has stepped down — their *primary* role becomes JuniorAnalyst. Ranked
  // 0 in ROLE_RANK (middleware/auth.js); never assignable as a primary
  // role (see ASSIGNABLE_ROLES in routes/users.js). Appended last so
  // existing enum value ordinals are unchanged.
  FormerPresident
}

enum AttendanceStatus {
  Present
  Absent
  Excused
}

enum VoteAction {
  Buy
  Hold
  Sell
}

enum PitchRequestStatus {
  Pending
  Approved
  Declined
}

enum LunchPeriod {
  First
  Second
  Both
}

model User {
  id                Int              @id @default(autoincrement())
  name              String
  email             String           @unique
  // Nullable so Google-only signups don't need a local password. They can
  // set one later via the forgot-password flow if they want dual login.
  passwordHash      String?
  googleId          String?          @unique
  role              Role
  extraRoles        Role[]           @default([])
  tokenVersion      Int              @default(0)
  twoFactorSecret        String?
  twoFactorEnabled       Boolean          @default(false) // any method active
  twoFactorTotpEnabled   Boolean          @default(false)
  twoFactorEmailEnabled  Boolean          @default(false)
  twoFactorMethod        String?          // legacy — retained to backfill; unused
  failedLogins           Int              @default(0)
  lockedUntil            DateTime?
  createdAt              DateTime         @default(now())
  // Day-of-week lunch period schedule. JSON shape:
  //   { mon: "First"|"Second"|"Both"|null, tue: ..., wed: ..., thu: ..., fri: ... }
  // Surfaced on the "Request a Pitch" form so the requester can see when
  // the President / target PM is free for a lunch meeting.
  lunchSchedule     Json?
  attendance        Attendance[]
  createdSessions   VotingSession[]  @relation("SessionCreator")
  ballots           Ballot[]
  industries        UserIndustry[]
  ledIndustries     Industry[]       @relation("IndustryLeader")
  pitchPresenters   PitchPresenter[]
  backupCodes       BackupCode[]
  twoFactorCodes    TwoFactorCode[]
  knownLogins       KnownLogin[]
  chatMessages      ChatMessage[]
  aiChatSessions    AiChatSession[]
  pitchRequests     PitchRequest[]   @relation("PitchRequestRequester")
  presidentDecisions PitchRequest[]  @relation("PitchRequestPresident")
  pmDecisions       PitchRequest[]   @relation("PitchRequestPM")
  rosterOverrides   EventRosterOverride[]
  tradeRequests     TradeRequest[]   @relation("TradeRequestCreator")
  presidentReviewsGiven    PresidentReview[] @relation("PresidentReviewReviewer")
  presidentReviewsReceived PresidentReview[] @relation("PresidentReviewPresident")
  researchNotes            ResearchNote[]
  researchSourcesCreated   ResearchSource[] @relation("ResearchSourceCreator")
  interviewsConducted      Interview[]      @relation("InterviewInterviewer")
  interviewsScreened       Interview[]      @relation("InterviewScreener")
  interviewsAttested       Interview[]      @relation("InterviewAttester")
  interviewsReviewed       Interview[]      @relation("InterviewReviewer")
  researchClaimsVerified   ResearchClaim[]  @relation("ResearchClaimVerifier")
  researchProjectsCreated  ResearchProject[]  @relation("ResearchProjectCreator")
  researchValuations       ResearchValuation[] @relation("ResearchValuationAuthor")
  researchArtifacts        ResearchArtifact[] @relation("ResearchArtifactUploader")
  researchTargets          ResearchTarget[]   @relation("ResearchTargetCreator")
  outreachDraftsWritten    OutreachDraft[]    @relation("OutreachDraftAuthor")
  outreachDraftsRejected   OutreachDraft[]    @relation("OutreachDraftRejecter")
  outreachDraftsSent       OutreachDraft[]    @relation("OutreachDraftSender")
  outreachApprovals        OutreachApproval[] @relation("OutreachApprover")
  siteVisits               SiteVisit[]        @relation("SiteVisitVisitor")
}

// Chat channels are addressed by a simple string:
//   "general"        — everyone has access
//   "industry:<id>"  — members of that industry only
model ChatMessage {
  id        Int      @id @default(autoincrement())
  channel   String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([channel, createdAt])
}

// Fingerprints of IPs a user has successfully signed in from. Used to warn
// them via email when a sign-in comes from a new location. IPs are hashed
// so the DB never stores raw IPs long-term.
model KnownLogin {
  id        Int      @id @default(autoincrement())
  userId    Int
  ipHash    String
  userAgent String?
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ipHash])
  @@index([userId])
}

model TwoFactorCode {
  id        Int      @id @default(autoincrement())
  userId    Int
  codeHash  String
  purpose   String   // 'setup' or 'login'
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BackupCode {
  id        Int       @id @default(autoincrement())
  userId    Int
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Industry {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  leaderId      Int?
  leader        User?          @relation("IndustryLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members       UserIndustry[]
  pitches       Pitch[]
  pitchRequests PitchRequest[]
  createdAt     DateTime       @default(now())
}

// Member-initiated request to pitch a stock with the President. Approval
// gates on the President: PM may approve/decline informationally but the
// President's decision is what flips the request to Approved/Declined.
//
// `deckRef` mirrors the Pitch.slideshowUrl scheme: either
//   "onedrive:ITEM_ID" (uploaded via /api/files/upload), or
//   a plain http(s) URL (e.g. a Google Drive / Slides link the user pasted).
// Submission requires a deck attached — empty deckRef is rejected.
model PitchRequest {
  id                    Int                @id @default(autoincrement())
  requesterId           Int
  requester             User               @relation("PitchRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  ticker                String
  companyName           String?
  thesis                String?
  industryId            Int?
  industry              Industry?          @relation(fields: [industryId], references: [id], onDelete: SetNull)
  // Snapshot of the PM at submission time so we don't re-resolve on
  // approval/decline (industry leaders can change). Nullable because not
  // every industry has a leader assigned.
  pmId                  Int?
  pm                    User?              @relation("PitchRequestPM", fields: [pmId], references: [id], onDelete: SetNull)
  // Proposed meeting date + lunch period so the President / PM can see
  // exactly when the requester wants to meet.
  proposedDate          DateTime?
  proposedLunch         LunchPeriod?
  // "HH:MM" 24h string. Validated server-side against the lunch-block
  // schedule so we never persist an out-of-range time.
  proposedStartTime     String?
  // LIBRARY / LOWER_COMMONS / ATHLETIC_COMMONS — validated server-side
  // against an allowlist (kept as a string so adding rooms is a code
  // change, not a migration).
  room                  String?
  notes                 String?
  deckRef               String             // "onedrive:..." or http(s) URL
  status                PitchRequestStatus @default(Pending)
  presidentId           Int?
  president             User?              @relation("PitchRequestPresident", fields: [presidentId], references: [id], onDelete: SetNull)
  presidentDecidedAt    DateTime?
  presidentDeclineReason String?
  pmDecidedAt           DateTime?
  pmApproved            Boolean?
  pmDeclineReason       String?
  // Flags so the requester sees an in-app notification once when the
  // status changes — same pattern as PitchPresenter.seenAt.
  requesterSeenAt       DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([requesterId])
}

model UserIndustry {
  userId     Int
  industryId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  industry   Industry @relation(fields: [industryId], references: [id], onDelete: Cascade)

  @@id([userId, industryId])
}

model PitchPresenter {
  pitchId    Int
  userId     Int
  assignedAt DateTime @default(now())
  seenAt     DateTime?
  pitch      Pitch    @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pitchId, userId])
}

model Pitch {
  id              Int              @id @default(autoincrement())
  pitcherName     String
  ticker          String
  date            DateTime
  location        String?
  slideshowUrl    String?
  industryId      Int?
  industry        Industry?        @relation(fields: [industryId], references: [id], onDelete: SetNull)
  // What the club decided after the pitch: "Buy" = we bought, "NoBuy" = we
  // voted no, null = not voted / still pending.
  votedOutcome    String?
  createdAt       DateTime         @default(now())
  votingSessions  VotingSession[]
  presenters      PitchPresenter[]
}

model VotingSession {
  id         Int       @id @default(autoincrement())
  ticker     String
  title      String?
  pitchId    Int?
  pitch      Pitch?    @relation(fields: [pitchId], references: [id], onDelete: SetNull)
  status     String    @default("open")
  // "buy"  → a pitch vote (Buy/Hold/Sell, proposed allocation).
  // "sell" → a vote to exit a holding we own (Sell/Hold, no amount).
  kind       String    @default("buy")
  // How a Buy session sizes the trade. "average" (default) lets each
  // Buy voter propose a dollar figure and we trade the mean. "fixed"
  // pins the amount up front — the creator names the number and members
  // only ratify it (Buy = yes, No = Hold). Ignored for sell sessions.
  amountMode  String   @default("average")
  // The pinned dollar figure when amountMode = "fixed". Null otherwise.
  fixedAmount Float?
  deadline   DateTime
  createdAt  DateTime  @default(now())
  createdBy  Int
  creator    User      @relation("SessionCreator", fields: [createdBy], references: [id])
  closedAt   DateTime?
  // LLM-generated 2-3 sentence recap of the closed session: tally, who
  // supported, proposed allocation range, main concerns from notes.
  // Lazily filled the first time someone views the session after it closes.
  synthesis  String?
  ballots    Ballot[]

  // DocuSign trade-confirmation linkage. Populated when an exec clicks
  // "Send trade confirmation" on a closed Buy session. We keep the
  // envelope ID for status polling / webhook reconciliation and the
  // tradeContext snapshot (ticker, shares, price, total at send time)
  // so the audit trail survives later quote drift.
  docusignEnvelopeId   String?
  docusignStatus       String?
  docusignSentAt       DateTime?
  docusignCompletedAt  DateTime?
  docusignTradeContext Json?

  // Trade requests that bundle this session into a multi-ticker envelope.
  // A Buy session is "claimed" once it appears as a non-Sell item on a
  // TradeRequest — the eligible-buys picker excludes claimed sessions.
  tradeRequestItems    TradeRequestItem[]

  @@index([createdAt])
}

// A bundled trade-confirmation envelope. Aggregates one or more Buy lines
// (each tied back to a closed Buy VotingSession) plus optional Sell lines
// (typically SPY, used to free up cash to fund the buys). One TradeRequest
// = one DocuSign envelope, regardless of how many tickers it carries.
//
// The single-session flow on VotingSession.docusign* still works for
// legacy single-ticker sends; this model is the path going forward.
model TradeRequest {
  id                   Int      @id @default(autoincrement())
  createdAt            DateTime @default(now())
  createdBy            Int
  creator              User     @relation("TradeRequestCreator", fields: [createdBy], references: [id])
  // Free-text exec note attached to the envelope (becomes part of the
  // email body). Optional.
  note                 String?
  // Frozen snapshot of what we sent — line items + per-line price +
  // grand total — so audits don't drift with later quote changes. Mirrors
  // VotingSession.docusignTradeContext.
  tradeContext         Json?
  docusignEnvelopeId   String?
  docusignStatus       String?
  docusignSentAt       DateTime?
  docusignCompletedAt  DateTime?
  // Settlement. Set when an exec marks the signed envelope as filled, which
  // writes the position + cash movements into the ledger. Null until then, and
  // the marker that makes execution idempotent (a request can't fill twice).
  executedAt           DateTime?
  executedByName       String?
  items                TradeRequestItem[]

  @@index([createdAt])
}

// One line on a TradeRequest. `kind` is "Buy" or "Sell". Sell lines have
// no votingSessionId — they're standalone (typically Sell SPY to cover the
// cash demand of the Buy lines).
model TradeRequestItem {
  id              Int           @id @default(autoincrement())
  tradeRequestId  Int
  tradeRequest    TradeRequest  @relation(fields: [tradeRequestId], references: [id], onDelete: Cascade)
  kind            String        // "Buy" | "Sell"
  ticker          String
  shares          Int
  pricePerShare   Float
  totalCost       Float
  votingSessionId Int?
  votingSession   VotingSession? @relation(fields: [votingSessionId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  @@index([tradeRequestId])
  @@index([votingSessionId])
}

model Ballot {
  id               Int            @id @default(autoincrement())
  sessionId        Int
  session          VotingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId           Int
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  action           VoteAction
  // Required when action = Buy. Dollar amount the voter thinks the club
  // should allocate, constrained to $1,500–$10,000 at the API layer. Null
  // for Hold/Sell.
  investmentAmount Float?
  note             String?
  castAt           DateTime       @default(now())

  @@unique([sessionId, userId])
}

model Event {
  id              Int          @id @default(autoincrement())
  title           String
  date            DateTime
  location        String?
  description     String?
  durationMinutes Int          @default(60)
  recurring       Boolean      @default(false)
  // Audience scope. 'all' = visible to every member (default);
  // 'advisory' = tagged as an Advisory Board event. Used by the
  // Calendar filter button. Extend with other audiences later if needed.
  audience        String       @default("all")
  // Optional deck attached to the event — same scheme as Pitch.slideshowUrl
  // and Report.fileUrl: either an `onedrive:ITEM_ID` ref or a plain http(s)
  // URL (Google Slides, etc.). All members see a "View slideshow" link
  // when present.
  slideshowUrl    String?
  attendance      Attendance[]
  rosterOverrides EventRosterOverride[]
  createdAt       DateTime     @default(now())
}

// Per-event roster overrides set by the super admin. Two cases:
//   included = false → user explicitly REMOVED from the event's roster.
//                      Shadows the role-based default audience query.
//   included = true  → user explicitly ADDED. Persists a manual addition
//                      from the super-admin "add member" picker even
//                      before any attendance record is written.
// Marking attendance on a user (POST /attendance) clears any "excluded"
// override — they're definitely on the roster if they have a status.
model EventRosterOverride {
  eventId  Int
  userId   Int
  included Boolean
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @default(now()) @updatedAt

  @@id([eventId, userId])
}

// A live position in the book. Was orphaned in the sheet era (nothing read or
// wrote it); it is becoming the real positions table as holdings move off the
// Google Sheet into the database. One row per ticker.
model Holding {
  id        Int       @id @default(autoincrement())
  ticker    String    @unique
  name      String?
  sector    String?
  shares    Float
  // Blended per-share average cost, recomputed from HoldingLot on each buy.
  // The column kept its original name — it has always meant average cost.
  costBasis Float
  // The club's cash sleeve (FGTXX) used to ride as a row in the holdings list.
  // We no longer store cash as a Holding — it is derived from the Transaction
  // ledger — but the flag is kept for any imported/legacy cash row and so the
  // portfolio assembler can mark a synthetic cash row.
  isCash    Boolean   @default(false)
  addedAt   DateTime  @default(now())
  // Soft-close: a fully-sold position keeps its row for history with closedAt
  // set. The live portfolio query filters to closedAt = null.
  closedAt  DateTime?
  updatedAt DateTime  @updatedAt
}

model Report {
  id          Int      @id @default(autoincrement())
  title       String
  author      String
  ticker      String?
  date        DateTime
  description String?
  fileUrl     String
  createdAt   DateTime @default(now())
}

model Attendance {
  id      Int              @id @default(autoincrement())
  userId  Int
  eventId Int
  status  AttendanceStatus
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  event   Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}

model PendingVerification {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  code         String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

model PendingInvite {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  role      Role
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int?
  userName   String?
  action     String
  resource   String?
  resourceId Int?
  metadata   String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model PortfolioSnapshot {
  id         Int      @id @default(autoincrement())
  date       DateTime @unique
  totalValue Float
  cashValue  Float?
}

// Daily yield snapshot for a Goldman Sachs money market fund. Scraped
// once a day from the GSAM Daily Rates PDF. We store the trio of yields
// the PDF publishes plus the dividend factor (the most precise way to
// accrue per-day interest on a 2a-7 fund); the cash-interest calc keys
// off `sevenDayCurrentYield` and falls back to `dividendFactor * 365`
// when the yield column is missing.
model MmfYieldSnapshot {
  id                     Int      @id @default(autoincrement())
  ticker                 String
  // Effective date as reported on the rate sheet, not the scrape time.
  // We dedupe per (ticker, date) so a re-scrape just refreshes the row.
  date                   DateTime
  sevenDayCurrentYield   Float?
  sevenDayEffectiveYield Float?
  oneDayYield            Float?
  dividendFactor         Float?
  scrapedAt              DateTime @default(now())

  @@unique([ticker, date])
  @@index([ticker, date])
}

// A single purchase lot for a ticker. We may buy the same stock at different
// times and prices; tracking each lot gives us an exact cost basis instead
// of relying on the sheet's rounded avg cost column.
model HoldingLot {
  id            Int      @id @default(autoincrement())
  ticker        String
  shares        Float
  pricePerShare Float
  buyDate       DateTime
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([ticker])
}

// Free-text investment thesis for a ticker we hold. One row per ticker.
// Editable only by super-admin. Consumed by the holding detail modal and
// (eventually) by the thesis-vs-news drift check in the risk panel.
model HoldingThesis {
  id            Int      @id @default(autoincrement())
  ticker        String   @unique
  thesis        String
  updatedByName String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

// The fund's cash + trade ledger. There is deliberately no stored cash
// balance: the spendable cash is the running sum of "cashDelta" across this
// table, so every dollar that moves leaves an auditable row. Buys and sells
// also record the share + price detail; a sell carries the realized P/L
// against the blended cost of the lots it relieved. tradeRequestId /
// votingSessionId tie a movement back to the envelope and vote that
// authorized it (null for manual deposits, dividends, fees).
model Transaction {
  id              Int      @id @default(autoincrement())
  // "Buy" | "Sell" | "Deposit" | "Withdraw" | "Dividend" | "Fee" | "Opening"
  kind            String
  ticker          String?
  shares          Float?
  pricePerShare   Float?
  // Signed cash effect: buys / withdrawals / fees negative; sells / deposits /
  // dividends positive. Whole-portfolio cash = SUM(cashDelta).
  cashDelta       Float
  // Realized P/L on a Sell, vs the blended cost of the lots relieved. Null on
  // every other kind.
  realizedPnl     Float?
  // Loose provenance links (not FK relations, to keep this additive). Null
  // unless the movement came from a trade.
  tradeRequestId  Int?
  votingSessionId Int?
  note            String?
  executedByName  String?
  executedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([ticker])
  @@index([executedAt])
}

// Persistent conversations with the in-house AI Assistant. The client
// never ships history back — every turn the server reads the full thread
// from these tables so a forged "assistant" message can't be used as
// precedent against the scope directive. Cascade from User so account
// deletion cleans up the whole chat history.
model AiChatSession {
  id        Int             @id @default(autoincrement())
  userId    Int
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Auto-derived from the first user message (truncated). Nullable until
  // the first turn completes.
  title     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  AiChatMessage[]

  @@index([userId, updatedAt])
}

model AiChatMessage {
  id        Int           @id @default(autoincrement())
  sessionId Int
  session   AiChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String        // 'user' | 'assistant'
  content   String
  // Per-reply telemetry for abuse review / debugging. Null on user rows.
  model     String?       // which provider served the turn
  latencyMs Int?
  createdAt DateTime      @default(now())

  @@index([sessionId, createdAt])
}

// AI-generated summary for an uploaded file, keyed by fileRef
// (same scheme used in Report.fileUrl / Pitch.slideshowUrl, e.g.
// "onedrive:ABC123"). One row per file — regenerations overwrite.
// Summaries are slow to produce (10-30s on the local GPU) so we
// persist them and let the UI fetch cached results.
model FileSummary {
  id         Int      @id @default(autoincrement())
  fileRef    String   @unique
  filename   String?  // Captured at generation time for display
  summary    String
  model      String?  // Which provider generated it (for future invalidation)
  charCount  Int?     // Size of the extracted text fed into the model
  truncated  Boolean  @default(false) // True when the source doc exceeded our char cap
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// OAuth tokens for file-storage providers (currently: OneDrive via
// Microsoft Graph). One row per provider — we always rebind the same
// account instead of multi-tenant. Stores the current access token +
// refresh token; access tokens expire hourly, refresh token is the
// long-lived credential used to mint new ones. If this row is empty,
// uploads are unavailable until a super admin runs the OAuth flow.
model FileProviderToken {
  id           Int      @id @default(autoincrement())
  provider     String   @unique // 'onedrive'
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scope        String?
  email        String?  // Which account the tokens are bound to — displayed in admin.
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}

// Monthly CPI forecast produced by the external Python forecaster running
// on the club's local server. The forecaster POSTs to /api/cpi/ingest with
// an HMAC signature; we upsert one row per `asOfMonth` (the latest CPI
// month used as input). Old runs are kept for the historical "what we
// predicted vs. what happened" backtest panel — never overwritten.
//
// `payload` stores the full JSON shape: forecasts[], backtest stats,
// per-model contributions, ensemble weights. The client reads from this
// JSON directly so the schema stays additive: the forecaster can grow
// new fields without a Prisma migration.
model CpiForecast {
  id        Int      @id @default(autoincrement())
  runAt     DateTime
  // "YYYY-MM" of the most recently RELEASED CPI month used as input.
  // Unique so the forecaster can re-POST a corrected run for the same
  // input month and we'll upsert rather than duplicate.
  asOfMonth String   @unique
  payload   Json
  createdAt DateTime @default(now())

  @@index([runAt])
}

// One row per (date, signalName). Mirrors DuckDB's signals_daily on
// the Windows server, with the latest publish winning on conflict.
// History feeds the sparklines on the /tankers panel.
model SeaSignal {
  date       DateTime @db.Date
  signalName String
  value      Float?
  updatedAt  DateTime @updatedAt

  @@id([date, signalName])
  @@index([signalName, date])
}

// Singleton row keyed on a fixed id. publish-snapshot upserts the
// rolling-latest payload here every two minutes. Storing the whole
// shape as Json keeps the schema flexible: we can add fields without
// migrations as the map UI evolves.
model SeaSnapshot {
  id          Int      @id @default(1)
  snapshotAt  DateTime
  vesselCount Int
  payload     Json
  updatedAt   DateTime @updatedAt
}

// End-of-year performance review submitted by a member about a President.
// A short Likert-scale set (currently four statements, stored as a JSON
// map keyed by q1..qN) plus an optional free-form comment. One row per
// reviewer × president × cycle; resubmitting upserts. Results are
// visible to the super-admin only, including the per-reviewer breakdown.
model PresidentReview {
  id           Int      @id @default(autoincrement())
  reviewerId   Int
  reviewer     User     @relation("PresidentReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  presidentId  Int
  president    User     @relation("PresidentReviewPresident", fields: [presidentId], references: [id], onDelete: Cascade)
  // Academic-year string, e.g. "2025-2026". Computed server-side from
  // the submission date so members don't have to think about it.
  cycle        String
  ratings      Json
  comment      String?
  submittedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([reviewerId, presidentId, cycle])
  @@index([presidentId, cycle])
}

// LLM-generated priority tag for a news article, keyed by URL. Lets us skip
// re-ranking articles we've already classified — articles don't change after
// publish, so the classification is stable. One row per unique URL. `model`
// records which local model generated the tag; useful for invalidation later
// (e.g. clear rows where model = '3b' after upgrading to 14b).
model ArticleRanking {
  id        Int      @id @default(autoincrement())
  url       String   @unique
  // Legacy tier tag ('high' | 'medium' | 'low'). Nullable for backwards
  // compat with rows written before the score column existed.
  priority  String?
  // Current-gen ranking: 0.0–10.0 with one decimal. Higher = more material.
  score     Float?
  reason    String?
  // AI-generated summary of the article body, filled lazily the first time
  // anyone opens the reader for this URL.
  summary   String?
  // Ticker this article was first fetched under. Set on insert, never
  // overwritten on update. Used to exclude broad-market ETF news (VOO,
  // QQQ, etc.) from club-wide summaries like Week in Review.
  ticker    String?
  model     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ticker])
}

// Cached daily OHLCV from Yahoo. Powers the Terminal GP chart, future
// screeners, and total-return calcs without re-hitting Yahoo on every load.
// Backfilled lazily the first time a ticker is requested (5y default),
// then refreshed nightly by the price-cache cron.
model PriceBar {
  id        Int      @id @default(autoincrement())
  ticker    String
  date      DateTime @db.Date
  open      Float?
  high      Float?
  low       Float?
  close     Float?
  adjClose  Float?
  volume    BigInt?
  source    String   @default("yahoo")
  fetchedAt DateTime @default(now())

  @@unique([ticker, date])
  @@index([ticker, date(sort: Desc)])
}

// A private free-text research note a member keeps on a ticker while
// doing diligence — their own thesis, open questions, a reminder to
// themselves. Strictly per-user: one note per (user, ticker), upserted
// on save, and never visible to anyone else. Cascade from User so an
// account deletion takes its notes with it. The terminal's NOTE panel
// reads and writes this through /api/notes, always scoped to the
// caller's own id (HoldingThesis is the club-wide analogue; this is
// the personal one).
model ResearchNote {
  id        Int      @id @default(autoincrement())
  userId    Int
  ticker    String
  body      String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ticker])
  @@index([userId])
}

// ── Field research ───────────────────────────────────────────────────
//
// Primary research: what we learned by talking to people who actually
// touch a business — former employees, distributors, customers,
// competitors. The house rule is that no fact enters a report without a
// pinned source, and these three tables are that rule made structural.
// A Claim cannot exist except as an assertion made by an identified
// speaker at a known moment in a recorded conversation.
//
// The chain is: ResearchSource (who) → Interview (the conversation, its
// transcript and its consent) → ResearchClaim (one assertion, pinned to
// speaker + millisecond offset). A report cites claim ids; anyone can
// walk a citation back to the audio and hear it said.

// Someone we interview. Separate from Interview because a good source
// gets called again across quarters, and their relationship to the
// company — which is what governs the MNPI risk — belongs to the person,
// not to any one conversation.
model ResearchSource {
  id           Int      @id @default(autoincrement())
  // How we refer to them in reports. Sources are often promised
  // anonymity, so the alias is the citable identity and `fullName`
  // stays internal.
  alias        String
  fullName     String?
  role         String?
  employer     String?
  // FormerEmployee | CurrentEmployee | Customer | Distributor |
  // Supplier | Competitor | IndustryExpert | Other. Kept as a string so
  // adding a category is a code change, not a migration. CurrentEmployee
  // is the high-risk one — see Interview.mnpiRisk.
  relationship String
  // Tickers this person can credibly speak to.
  tickers      String[] @default([])
  notes        String?
  createdById  Int?
  createdBy    User?    @relation("ResearchSourceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  interviews   Interview[]
  targets      ResearchTarget[]

  @@index([relationship])
}

// One conversation. Holds the recording reference, the diarized
// transcript, and the compliance record for the call.
model Interview {
  id            Int      @id @default(autoincrement())
  sourceId      Int
  source        ResearchSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  // The company under study. Nullable for industry-level calls that
  // aren't about one name.
  ticker        String?
  title         String
  conductedAt   DateTime
  interviewerId Int?
  interviewer   User?    @relation("InterviewInterviewer", fields: [interviewerId], references: [id], onDelete: SetNull)

  // Draft | Recorded | Transcribed | Extracted | Quarantined
  status        String   @default("Draft")

  // "onedrive:ITEM_ID" — the audio, stored the same way every other
  // member upload is.
  recordingRef  String?
  // Plain reading copy of the transcript.
  transcript    String?
  // The diarized word stream from scribe_v2: [{text, startMs, endMs,
  // speaker}]. This is the evidence of record — claims index into it by
  // offset, so it is written once and never edited in place. A
  // correction is a new claim annotation, not a rewrite.
  transcriptWords Json?
  // Which scribe model produced it, for later re-runs.
  transcriptModel String?
  durationMs    Int?

  // ── Compliance ──
  // Recording someone without consent is both unlawful in two-party
  // states and fatal to a source relationship. No transcript is
  // accepted for an interview without this set.
  consentObtained Boolean @default(false)
  consentNote     String?
  // low | elevated | prohibited. Elevated is the default for anyone
  // still inside the company; prohibited quarantines the interview so
  // its claims can never be cited.
  mnpiRisk        String  @default("low")
  screenedAt      DateTime?
  screenedById    Int?
  screenedBy      User?   @relation("InterviewScreener", fields: [screenedById], references: [id], onDelete: SetNull)
  // Set when an interview is judged to contain material non-public
  // information. Quarantined interviews stay in the archive for the
  // audit trail but are excluded from every claim query.
  quarantined     Boolean @default(false)
  quarantineNote  String?

  // Pre-call attestation. The screen catches MNPI after the fact; this
  // is the part that shapes the conversation before it happens, which is
  // where compliance actually works. Recorded per interview because it
  // is a statement about THAT call, not a setting.
  attestedAt      DateTime?
  attestedById    Int?
  attestedBy      User?     @relation("InterviewAttester", fields: [attestedById], references: [id], onDelete: SetNull)
  // A person's decision after reading a flagged transcript. Distinct
  // from the automated screen: a machine flag that nobody has looked at
  // is an open question, not a judgement.
  reviewedAt      DateTime?
  reviewedById    Int?
  reviewedBy      User?     @relation("InterviewReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote      String?
  // What the screen actually found: its reason and the phrases that
  // tripped it. Without this the panel can only say "elevated" and has
  // to ask a person what they think, which inverts the job — the model
  // is supposed to do the catching.
  screenResult    Json?

  // Nullable on purpose: a one-off call, or one logged before anyone
  // opened a project, is still a real interview.
  projectId     Int?
  project       ResearchProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  claims        ResearchClaim[]

  @@index([ticker, conductedAt(sort: Desc)])
  @@index([sourceId])
  @@index([status])
  @@index([projectId])
}

// A single assertion, pinned to who said it and when. This is the unit a
// report cites. `startMs`/`endMs` index into the parent interview's
// transcriptWords, which is why that column is immutable.
model ResearchClaim {
  id          Int      @id @default(autoincrement())
  interviewId Int
  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  ticker      String?
  // The assertion in the speaker's own words where possible.
  text        String
  // Verbatim supporting quote, for the footnote.
  quote       String?
  speaker     String?
  startMs     Int
  endMs       Int?
  // Short normalized subject ("rebate structure", "store traffic") so
  // claims from different interviews can be triangulated against each
  // other.
  topic       String?
  // fact | opinion | forecast. A forecast from a distributor is not the
  // same kind of evidence as a fact about their own invoices, and a
  // report should never blur them.
  kind        String   @default("fact")
  // 0.0-1.0, the extractor's confidence that the claim is faithfully
  // pulled from the transcript. NOT a judgement of whether it is true.
  extractionConfidence Float?
  // Which project question this bears on. Nullable — plenty of good
  // material answers something nobody thought to ask, and forcing every
  // claim into a pre-written bucket would quietly discard it.
  questionId  Int?
  question    ResearchQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  // How this claim came to exist: "extract" from the general sweep of a
  // transcript, "answer-scan" from reading it against one question.
  // Re-extraction wipes and rewrites what the extractor produced, and
  // without this it would take the scan's findings with it — silently,
  // along with every question link on them. Two different ways of
  // reading the same tape, and only one of them owns those rows.
  origin      String   @default("extract")
  // Set by a human who has listened back and agreed the pin is right.
  verifiedById Int?
  verifiedBy   User?   @relation("ResearchClaimVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([ticker, topic])
  @@index([interviewId])
  @@index([questionId])
}

// A field-research project: everything gathered on one company, in one
// place. The container the terminal's FLD panel opens.
//
// A real channel-check effort accumulates more than interviews — the
// question guide you wrote before the first call, the store photos, the
// pricing sheet a distributor emailed over, the 10-K pages you marked
// up, the running memo. Scattering those across a drive is how a project
// becomes unreproducible six months later when someone asks where a
// number came from. Everything hangs off this row.
model ResearchProject {
  id          Int      @id @default(autoincrement())
  ticker      String?
  name        String
  // What we are trying to find out. Written before the work starts, so
  // the project can be judged against what it set out to answer rather
  // than what it happened to find.
  brief       String?
  // Open | Fieldwork | Synthesis | Closed
  status      String   @default("Open")
  createdById Int?
  createdBy   User?    @relation("ResearchProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  interviews  Interview[]
  artifacts   ResearchArtifact[]
  questions   ResearchQuestion[]
  targets     ResearchTarget[]
  visits      SiteVisit[]
  valuations  ResearchValuation[]

  @@index([ticker, updatedAt(sort: Desc)])
  @@index([status])
}

// Anything attached to a project. Either an uploaded file OR an inline
// text body — a question guide someone typed straight in is as much a
// project artifact as a PDF they dragged over, and forcing the second
// shape on the first just makes people keep scripts in Notes instead.
model ResearchArtifact {
  id          Int      @id @default(autoincrement())
  projectId   Int
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // guide | script | document | data | photo | memo | other. A string,
  // so adding a category is a code change rather than a migration.
  kind        String   @default("document")
  title       String
  // "onedrive:ITEM_ID" for uploads; null for inline text.
  fileRef     String?
  filename    String?
  // Inline text, for guides and memos written in the app.
  body        String?
  note        String?
  uploadedById Int?
  uploadedBy  User?    @relation("ResearchArtifactUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, kind])
}

// What the project set out to answer. The spine of the whole process.
//
// Without this a project is a pile of interesting facts with no finish
// line — you cannot tell whether you are done, and "done" quietly
// becomes "tired of calling people". Questions are written from the
// brief BEFORE fieldwork starts, so the work is judged against what it
// meant to find out rather than whatever happened to turn up. Every
// claim and observation links back to one, which is what makes coverage
// computable: answered, thin, or still open.
model ResearchQuestion {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  text      String
  // Why it matters to the thesis — the "so what" that stops a question
  // list becoming trivia.
  rationale String?
  // Display order; the questions that decide the thesis go first.
  rank      Int      @default(0)
  // Open | Answered | Abandoned. Set by a human, not inferred: evidence
  // volume is not the same as being satisfied, and only a person should
  // decide a question is closed.
  status    String   @default("Open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims       ResearchClaim[]
  observations SiteObservation[]

  @@index([projectId, rank])
}

// Someone we want to talk to, and how that outreach is going. The front
// of the funnel — without it there are no interviews, and "who haven't
// we tried yet" is the question that actually paces a project.
//
// Separate from ResearchSource: a target is a lead, most of which never
// become sources. Collapsing the two would either pollute the source
// list with people who never replied, or lose the record of everyone we
// failed to reach — which is itself a finding about a company.
model ResearchTarget {
  id           Int      @id @default(autoincrement())
  projectId    Int
  project      ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  // Where they sit in the value chain: FormerEmployee, Distributor,
  // Customer, Supplier, Competitor, Landlord, IndustryExpert, Other.
  relationship String
  employer     String?
  role         String?
  // How we might reach them, kept deliberately vague-friendly — often
  // "via LinkedIn" or "Sarah's old colleague" rather than an address.
  channel      String?
  // The address, on its own, when we actually have one. Kept out of
  // `channel` because a mailto link cannot be built from "LinkedIn, or
  // ask Sarah" and a list you cannot click is a list nobody works.
  email        String?
  // Call order. An outreach list is not a set, it is a queue — the
  // whole question on a given afternoon is who to ring first, and a
  // table sorted by insertion time answers a question nobody asked.
  // Null sorts last, so an unranked name is still visible.
  priority     Int?
  // A short badge for whatever cut actually matters on this project.
  // Deliberately free text: `relationship` says how someone touches the
  // business, which is not the same as what they can tell us. On CHRW
  // two former employees are both FormerEmployee, but one left during
  // the headcount reduction and one left six years before it — they
  // answer different questions and must not be worked as one bucket.
  tier         String?
  // Identified | Contacted | Scheduled | Completed | Declined | Unreachable
  status       String   @default("Identified")
  // Set once outreach converts, so a completed target points at the
  // source record it became.
  sourceId     Int?
  source       ResearchSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  notes        String?
  lastContactAt DateTime?
  createdById  Int?
  createdBy    User?    @relation("ResearchTargetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  drafts       OutreachDraft[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId, status])
}

// An outreach email, and the second pair of eyes it needs before it
// goes out.
//
// Everything else in this app is reversible. A vote can be re-run, a
// claim can be struck, a valuation can be revised. An email cannot be
// unsent — it lands in a stranger's inbox carrying the club's name and
// the school's, written by a student on behalf of a fund that manages
// real endowment money. That asymmetry is the whole reason this table
// exists.
//
// Three rules the server enforces, none of which are advisory:
//
//   TWO DISTINCT PEOPLE must approve. Not "an approver" — two, counted
//   as separate human beings, which is why approvals are rows in their
//   own table with a uniqueness constraint rather than a pair of
//   columns. One person cannot satisfy this alone no matter how many
//   times they click, because the database will not let them.
//
//   Editing a draft VOIDS every approval on it. Otherwise the gate is
//   trivially defeated by getting a bland draft signed off and then
//   rewriting it, which is the failure mode worth designing against —
//   not malice, just someone tidying a sentence afterwards and not
//   thinking about what that means. Approvals attach to WORDS, not to
//   a row id.
//
//   Sent requires both approvals. Marking a draft sent is how the
//   funnel moves, so that is where the gate sits.
//
// Drafts are kept after sending rather than collapsed into the target's
// notes: what we actually said to someone is evidence, and the record
// of who signed off on it is the point of the exercise.
model OutreachDraft {
  id           Int      @id @default(autoincrement())
  targetId     Int
  target       ResearchTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  subject      String
  body         String
  authorId     Int?
  author       User?    @relation("OutreachDraftAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  approvals    OutreachApproval[]

  // The compliance read, re-run on every edit because it is the WORDS
  // that were screened, exactly as with approvals.
  //
  // screenedAt null is a real state and must not render as clean: it
  // means nothing has read this yet. screenModelOk false means only the
  // keyword floor ran, which is a weaker statement than a low risk and
  // has to be shown as one.
  screenRisk     String?
  screenReason   String?
  screenFindings Json?
  screenModelOk  Boolean  @default(false)
  screenedAt     DateTime?

  // A rejection is as much a record as an approval — "we decided not to
  // send this, and why" is worth keeping. One rejection parks the draft
  // until it is edited, which clears it along with the approvals.
  rejectedById Int?
  rejectedBy   User?    @relation("OutreachDraftRejecter", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt   DateTime?
  reviewNote   String?

  sentAt       DateTime?
  sentById     Int?
  sentBy       User?    @relation("OutreachDraftSender", fields: [sentById], references: [id], onDelete: SetNull)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([targetId, createdAt])
}

// One person signing off on one draft. The unique constraint is the
// control: without it "two approvals" is a counter anybody can run up
// on their own, and the whole gate reduces to clicking twice.
model OutreachApproval {
  id        Int      @id @default(autoincrement())
  draftId   Int
  draft     OutreachDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation("OutreachApprover", fields: [userId], references: [id], onDelete: Cascade)
  note      String?
  createdAt DateTime @default(now())

  @@unique([draftId, userId])
}

// A store visit or channel check — going and looking, rather than
// asking. For a retail name this is most of the fieldwork: what is on
// the shelf, what it costs, how busy it is, how many staff are on.
model SiteVisit {
  id          Int      @id @default(autoincrement())
  projectId   Int
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticker      String?
  // "Target #1247, Atlantic Terminal, Brooklyn" — whatever identifies
  // the location well enough to go back.
  location    String
  banner      String?
  visitedAt   DateTime
  visitorId   Int?
  visitor     User?    @relation("SiteVisitVisitor", fields: [visitorId], references: [id], onDelete: SetNull)
  // Structured template answers: shelf state, promo depth, staffing,
  // traffic count, stock gaps. JSON because the useful template differs
  // by sector, and a column per field would freeze it to retail.
  observations Json?
  notes       String?
  weather     String?
  // Day of week and hour matter enormously for retail traffic reads — a
  // Tuesday 11am count says nothing about a Saturday.
  dayPart     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  siteObservations SiteObservation[]

  @@index([projectId, visitedAt(sort: Desc)])
}

// One recorded observation from a visit. Deliberately NOT a
// ResearchClaim: a claim is pinned to a millisecond in a transcript, and
// that guarantee is the whole point of the ledger. What someone saw with
// their own eyes is different evidence — often stronger than hearsay,
// but it has no recording to walk back to. Keeping them separate lets
// coverage count both while never blurring where a fact came from.
model SiteObservation {
  id         Int      @id @default(autoincrement())
  visitId    Int
  visit      SiteVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  questionId Int?
  question   ResearchQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)
  text       String
  topic      String?
  // measurement | condition | pricing | traffic | assortment | other
  kind       String   @default("condition")
  // Photographic backup, as an artifact reference.
  artifactId Int?
  createdAt  DateTime @default(now())

  @@index([visitId])
  @@index([questionId])
}

// What the work concluded a share is worth, and what it assumed to get
// there.
//
// The spreadsheet can live in artifacts, but a file is not a finding: a
// number nobody can restate without opening it is a number nobody argues
// with. So the outputs come out — bear, base, bull, because a single
// point estimate hides how much of the answer is the assumptions — and
// the assumptions that drive them are recorded beside them.
//
// The point of putting this next to the claim ledger is that an
// assumption can cite it. "Restock twice a week" is a number somebody
// said on a recording at a timestamp; "12% revenue growth" is usually
// nobody's number at all. Keeping both in one project makes the
// difference visible instead of letting them look alike in a model.
model ResearchValuation {
  id          Int      @id @default(autoincrement())
  projectId   Int
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ticker      String?
  // dcf | merger | comps | other. A merger model asks different
  // questions of the same company — what multiple was paid, not what the
  // cash flows are worth — so the kind changes which assumptions the UI
  // asks for.
  kind        String   @default("dcf")
  name        String
  // The three cases. Nullable because a model in progress has a base
  // long before it has a defensible bear, and forcing a placeholder in
  // would put a made-up number where a missing one belongs.
  bear        Float?
  base        Float?
  bull        Float?
  // Share price the targets were struck against, so an upside figure
  // stays honest as the market moves.
  priceAtWrite Float?
  // The currency the three cases are in. Lindt trades at CHF 95,600 a
  // registered share; rendering that with a dollar sign is not a
  // cosmetic slip, it is a different number. Defaults to USD because
  // most of the book is, but it is stored rather than assumed.
  currency    String   @default("USD")
  // The price we would actually want to be told about. A valuation that
  // concludes the shares are worth more than they cost is an opinion
  // until somebody is watching the gap close — and nobody refreshes a
  // quote daily for a name they do not own.
  buyBelow    Float?
  // Set when the level was last announced, so a name that sits below it
  // for a fortnight is reported once rather than every morning. Cleared
  // when it climbs back above, so the NEXT crossing is news again.
  alertedAt   DateTime?
  // A model is only good until the facts under it move. Set to the next
  // reporting date, this is what makes the panel say a valuation is
  // stale rather than letting a March DCF look current in August.
  reviewBy    DateTime?
  // Who gets told when the level is hit. Email addresses rather than
  // user ids, and stored on the valuation rather than inferred from a
  // role: the President of a student club changes every year, so a
  // role-based list would quietly hand next year's officers a watch
  // they never set and drop the people who did the work.
  watchers    String[]
  // [{ label, value, unit?, claimId?, note? }] — the inputs that drive
  // the cases. claimId points at a ResearchClaim when the assumption
  // came from primary research rather than being picked; validated on
  // write against claims in this same project.
  assumptions Json?
  note        String?
  asOf        DateTime @default(now())
  createdById Int?
  createdBy   User?    @relation("ResearchValuationAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([ticker, asOf(sort: Desc)])
}
