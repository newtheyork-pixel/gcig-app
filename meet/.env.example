# Griffin Fund meeting server. Copy to .env via ./setup.sh, which fills in
# every secret below. Never commit the generated .env.
#
# The upstream file this tracks is docker-jitsi-meet's env.example at the
# tag pinned in docker-compose.yml. When you bump the tag, diff the two.

#
# Where it lives
#
CONFIG=/home/thom/griffin-meet/cfg
JITSI_IMAGE_VERSION=stable-11146-2
RESTART_POLICY=unless-stopped
TZ=America/New_York

PUBLIC_URL=https://meet.thegriffinfund.org
XMPP_DOMAIN=meet.jitsi
XMPP_AUTH_DOMAIN=auth.meet.jitsi
XMPP_MUC_DOMAIN=muc.meet.jitsi
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.jitsi
XMPP_GUEST_DOMAIN=guest.meet.jitsi
XMPP_RECORDER_DOMAIN=recorder.meet.jitsi
XMPP_SERVER=xmpp.meet.jitsi
XMPP_BOSH_URL_BASE=http://xmpp.meet.jitsi:5280
JVB_BREWERY_MUC=jvbbrewery

#
# TLS is terminated by the Cloudflare tunnel, so the web container speaks
# plain HTTP on a loopback port and never sees a certificate. Turning on
# Let's Encrypt here would fight the tunnel for port 80.
#
HTTP_PORT=8016
HTTPS_PORT=8017
DISABLE_HTTPS=1
ENABLE_HTTP_REDIRECT=0
ENABLE_LETSENCRYPT=0
ENABLE_HSTS=0
# The tunnel is the only thing that should ever talk to the web container.
PROSODY_TRUSTED_PROXIES=127.0.0.1,::1

#
# Signalling over WebSocket. Cloudflare tunnels carry WebSocket fine; BOSH
# long-polling through a tunnel is the configuration that tends to stall.
#
ENABLE_XMPP_WEBSOCKET=1

#
# Who may start a meeting.
#
# Every room is created by a Griffin member holding a JWT minted by our own
# API at /api/meet/rooms/:code/token. ENABLE_GUESTS lets someone without a
# token join a room a member has already opened, which is what makes an
# outside expert on a call sheet able to click a link and be let in.
#
# TOKEN_AUTH_URL is where Jitsi sends anyone who arrives without a token.
# It points back at our app, which signs them in and returns them holding
# one, so a member who clicks a raw link is not shown an XMPP error.
#
ENABLE_AUTH=1
ENABLE_GUESTS=1
AUTH_TYPE=jwt
JWT_APP_ID=griffin
JWT_APP_SECRET=__GENERATE__
JWT_ACCEPTED_ISSUERS=griffin
JWT_ACCEPTED_AUDIENCES=griffin
JWT_ALLOW_EMPTY=0
JWT_ENABLE_DOMAIN_VERIFICATION=0
TOKEN_AUTH_URL=https://thegriffinfund.org/meeting?room={room}
ENABLE_AUTO_OWNER=1
# A room nobody has opened yet should not be creatable by a stray guest.
ENABLE_REQUIRE_DISPLAY_NAME=1

#
# Media path.
#
# JVB_ADVERTISE_IPS is deliberately left empty. The house has a dynamic
# Spectrum address, so a hard-coded IP goes stale on the next lease and
# every call silently fails to connect. The STUN harvester below asks a
# public server what our address is at startup instead, which survives the
# lease change. If you ever move this to a box with a static IP, set the
# address here and it takes precedence.
#
JVB_PORT=10000
JVB_ADVERTISE_IPS=
JVB_STUN_SERVERS=meet-jit-si-turnrelay.jitsi.net:443,stun.l.google.com:19302
JVB_DISABLE_STUN=0
JVB_ADVERTISE_PRIVATE_CANDIDATES=1
JVB_REQUIRE_VALID_ADDRESS=0
VIDEOBRIDGE_MAX_MEMORY=4096m
JICOFO_MAX_MEMORY=3072m

#
# Bandwidth. This is the setting that matters most here.
#
# The bridge receives one stream per speaker and sends one copy per speaker
# per viewer, so its upload grows with the square of the people on camera.
# Measured upstream on this line is 33 Mbps, which is the entire budget.
# The per-room ceilings live in branding/custom-config.js; these are the
# encoder bitrates that feed them.
#
ENABLE_SIMULCAST=1
ENABLE_ADAPTIVE_MODE=1
ENABLE_TCC=1
ENABLE_REMB=1
RESOLUTION=720
RESOLUTION_MIN=180
RESOLUTION_WIDTH=1280
RESOLUTION_WIDTH_MIN=320
VIDEOQUALITY_PREFERRED_CODEC=VP9
VIDEOQUALITY_BITRATE_VP9_LOW=100000
VIDEOQUALITY_BITRATE_VP9_STANDARD=300000
VIDEOQUALITY_BITRATE_VP9_HIGH=1200000
VIDEOQUALITY_BITRATE_VP8_LOW=200000
VIDEOQUALITY_BITRATE_VP8_STANDARD=500000
VIDEOQUALITY_BITRATE_VP8_HIGH=1500000
AUDIO_QUALITY_OPUS_BITRATE=24000
ENABLE_OPUS_RED=1
ENABLE_STEREO=0

#
# Behaviour
#
ENABLE_P2P=1
ENABLE_PREJOIN_PAGE=1
ENABLE_WELCOME_PAGE=1
ENABLE_CLOSE_PAGE=0
ENABLE_BREAKOUT_ROOMS=1
ENABLE_LOBBY=1
ENABLE_AV_MODERATION=1
ENABLE_NOISY_MIC_DETECTION=1
ENABLE_TALK_WHILE_MUTED=1
ENABLE_NO_AUDIO_DETECTION=1
ENABLE_AUDIO_PROCESSING=1
ENABLE_AUTOMATIC_GAIN_CONTROL=1
START_WITH_AUDIO_MUTED=0
START_WITH_VIDEO_MUTED=1
DISABLE_DEEP_LINKING=1
DEFAULT_LANGUAGE=en
DEPLOYMENTINFO_ENVIRONMENT=griffin-prod
MAX_PARTICIPANTS=60

#
# Recording is off. Turning it on means standing up Jibri, which needs its
# own container and a lot more upload than this line has. A meeting that
# must be kept gets recorded locally by the person running it.
#
ENABLE_RECORDING=0
ENABLE_SERVICE_RECORDING=0
ENABLE_LOCAL_RECORDING=1
ENABLE_LOCAL_RECORDING_NOTIFY_ALL_PARTICIPANT=1
ENABLE_TRANSCRIPTIONS=0
ENABLE_LIVESTREAMING=0

#
# Telemetry off. Nothing about a Griffin meeting goes to a third party.
#
ENABLE_STATS_ID=0
RTCSTATS_ENABLED=0
ENABLE_E2EPING=0

#
# Internal secrets, all filled by setup.sh
#
JICOFO_COMPONENT_SECRET=__GENERATE__
JICOFO_AUTH_PASSWORD=__GENERATE__
JVB_AUTH_PASSWORD=__GENERATE__
JIGASI_XMPP_PASSWORD=__GENERATE__
JIBRI_RECORDER_PASSWORD=__GENERATE__
JIBRI_XMPP_PASSWORD=__GENERATE__
JVB_AUTH_USER=jvb
JIGASI_XMPP_USER=jigasi
JIBRI_XMPP_USER=jibri
JIBRI_RECORDER_USER=recorder

#
# Branding. Served by branding/nginx-custom/griffin.conf out of the config
# volume, so a Jitsi image upgrade cannot overwrite it.
#
DYNAMIC_BRANDING_URL=https://meet.thegriffinfund.org/griffin/branding.json
